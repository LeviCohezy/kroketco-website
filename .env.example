# Copy these into your host's environment (Coolify → app → Environment Variables).
# Defaults live in the Dockerfile; only ADMIN_PASSWORD MUST be changed for production.

# Admin login password (/login-admin). Put the real value in .env (local) and
# in the host's environment variables — never in this committed file.
# Changing it on the host also overrides a password set via "Wachtwoord vergeten?".
ADMIN_PASSWORD=your-admin-password

# Where the SQLite database + uploaded images are stored. These point at the
# persistent volume you mount at /data. Leave as-is unless you change the mount.
CMS_DB_PATH=/data/cms.db
UPLOAD_DIR=/data/uploads

# App listens here (Coolify/Traefik proxies to it automatically).
PORT=3000

# --- Email notifications for the contact forms -----------------------------
# Every contact submission is saved to the CRM and emailed to CONTACT_TO.
# Preferred: Resend (HTTP API, no SMTP). Without a verified domain the sender is
# onboarding@resend.dev, which only delivers to the Resend account's own e-mail.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Kroketco website <website@kroketco.be>   (needs a verified domain)
CONTACT_TO=info@kroketco.be

# Fallback when RESEND_API_KEY is unset: SMTP.
# For a Hostinger mailbox, host is usually smtp.hostinger.com.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@kroketco.be
SMTP_PASS=your-mailbox-password
# Optional override (defaults to SMTP_USER):
SMTP_FROM=info@kroketco.be

# --- Password reset ("Wachtwoord vergeten?" on /login-admin) ----------------
# Uses the e-mail settings above. The reset link is mailed to RESET_TO.
RESET_TO=info@kroketco.be
# Public URL of the site, used to build the reset link (no trailing slash).
SITE_URL=https://kroketco.be
